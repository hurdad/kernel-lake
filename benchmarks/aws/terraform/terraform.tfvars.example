# Copy to terraform.tfvars and fill in real values -- that file is
# gitignored (see ../../../.gitignore) since it holds deployer-specific
# values (an SSH key name that must already exist in your AWS account, and
# your own IP for allowed_ssh_cidr), not shared defaults.

ssh_key_name              = "your-ec2-key-pair-name"
allowed_ssh_cidr          = "203.0.113.4/32" # your own public IP, /32
kernellake_instance_count = 1
# g6.xlarge is the current default (see variables.tf) -- fits comfortably
# under an 8-vCPU G/VT-family quota with 4 to spare, letting 2 replicas
# run at once for the M4 concurrency sweep's first step. Larger sizes
# (g6.2xlarge: 8 vCPUs, same GPU, more host RAM; g6.4xlarge: 16 vCPUs) need
# more quota -- see docs/COST_ESTIMATES.md.
# kernellake_instance_type  = "g6.2xlarge"
