# This is a Terraform template (rendered by monitoring_instance.tf's inner
# templatefile() call before being embedded in monitoring-init.sh) -- the
# "for" loop directives and dollar-brace interpolations below are Terraform
# template syntax, not literal Prometheus config syntax; the *rendered*
# output (real IPs substituted in) is what actually lands on the
# monitoring instance as prometheus.yml.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Each KernelLake host: node_exporter (host CPU/mem/net/disk),
  # dcgm-exporter (GPU utilization/memory/power/temperature), and the
  # OTel Collector's own Prometheus exporter (kernellake-server's real
  # query-level metrics -- see ../terraform/user-data/kernellake-host-init.sh
  # and this project's "OTel -> Prometheus" design).
%{ for ip in kernellake_ips ~}
  - job_name: "kernellake-host-node-${ip}"
    static_configs:
      - targets: ["${ip}:9100"]
        labels:
          instance_role: kernellake-host
  - job_name: "kernellake-host-gpu-${ip}"
    static_configs:
      - targets: ["${ip}:9400"]
        labels:
          instance_role: kernellake-host
  - job_name: "kernellake-host-otel-${ip}"
    static_configs:
      - targets: ["${ip}:8889"]
        labels:
          instance_role: kernellake-host
%{ endfor ~}

  # Spark host: node_exporter only -- no long-lived master/worker daemon
  # to instrument via JMX anymore (see
  # ../terraform/user-data/spark-local-init.sh): queries run in local[*]
  # mode as short-lived SSH-invoked Python processes
  # (runner/pyspark_query_loop.py), same shape as the DuckDB host below.
  # Skipped entirely when enable_spark=false (spark_host_ip renders "" --
  # see monitoring_instance.tf).
%{ if spark_host_ip != "" ~}
  - job_name: "spark-host-node"
    static_configs:
      - targets: ["${spark_host_ip}:9100"]
        labels:
          instance_role: spark-host
%{ endif ~}

  # DuckDB host: node_exporter only -- no long-lived query engine process
  # to instrument beyond host-level CPU/mem/net/disk, since queries run as
  # short-lived SSH-invoked Python processes (see
  # ../terraform/user-data/duckdb-host-init.sh). Skipped entirely when
  # enable_duckdb=false (duckdb_host_ip renders "" -- see monitoring_instance.tf).
%{ if duckdb_host_ip != "" ~}
  - job_name: "duckdb-host-node"
    static_configs:
      - targets: ["${duckdb_host_ip}:9100"]
        labels:
          instance_role: duckdb-host
%{ endif ~}
